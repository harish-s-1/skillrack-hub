# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Claude API key for the code explainer
ANTHROPIC_API_KEY=

# Random string. Vercel Cron sends it as a Bearer token to /api/cron/snapshot
CRON_SECRET=

# Used to hash visitor IPs for rate limiting. Any long random string.
IP_SALT=
